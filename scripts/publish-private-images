#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
OWNER="${NEXUS_GHCR_OWNER:-lucapohl-angel}"
REGISTRY="ghcr.io"
RUNTIME_REPOSITORY="$REGISTRY/$OWNER/nexus-ml-v2-runtime"
APP_REPOSITORY="$REGISTRY/$OWNER/nexus-ml-v2"
WAIT_SECONDS="${NEXUS_STARTUP_TIMEOUT:-300}"


info() { printf '\033[1;36m[nexus-publish]\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m[nexus-publish]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[nexus-publish]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Publish a reviewed private runtime and application image to GHCR.

Usage:
  ./scripts/publish-private-images --approve-reviewed-runtime

Required:
  - a running Docker daemon
  - GHCR_TOKEN with read:packages and write:packages
  - the reviewed private catalog/prototype/policy sources used by the exporter

The explicit approval flag is intentional: MLBB artwork/catalog updates must be human
reviewed before promotion. The script validates, builds, starts, checks authentication,
and only then pushes immutable and stable tags.
EOF
}

[[ "${1:-}" == "--approve-reviewed-runtime" ]] || { usage; exit 2; }
shift
(($# == 0)) || die "unknown option: $1"
command -v docker >/dev/null || die "docker is required"
command -v uv >/dev/null || die "uv is required"
command -v curl >/dev/null || die "curl is required"
docker info >/dev/null 2>&1 || die "Docker is unavailable; start the daemon and grant this user access"
[[ -n "${GHCR_TOKEN:-}" ]] || die "GHCR_TOKEN with read:packages and write:packages is required"

if ! git -C "$ROOT_DIR" diff --quiet HEAD -- \
  Dockerfile Dockerfile.runtime nexus_v2 profiles pyproject.toml uv.lock README.md LICENSE; then
  die "application-image sources contain uncommitted changes; commit and test them before publishing"
fi
untracked_source="$(git -C "$ROOT_DIR" ls-files --others --exclude-standard -- nexus_v2 profiles)"
[[ -z "$untracked_source" ]] || die "application-image sources contain untracked files; commit them before publishing"

work="$(mktemp -d "${TMPDIR:-/tmp}/nexus-private-publish.XXXXXX")"
container=""
cleanup() {
  [[ -z "$container" ]] || docker rm -f "$container" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# Isolate registry credentials from ~/.docker/config.json. Docker discovers CLI
# plugins below DOCKER_CONFIG, so expose the verified user-local Buildx binary there.
mkdir -p "$work/docker-config/cli-plugins"
buildx_plugin="$HOME/.docker/cli-plugins/docker-buildx"
[[ -x "$buildx_plugin" ]] || die "Docker Buildx is required"
ln -s "$buildx_plugin" "$work/docker-config/cli-plugins/docker-buildx"
export DOCKER_CONFIG="$work/docker-config"
docker buildx version >/dev/null
printf '%s' "$GHCR_TOKEN" | docker login "$REGISTRY" -u "$OWNER" --password-stdin >/dev/null
ok "Authenticated to $REGISTRY."

require_private_package() {
  local package="$1" visibility
  visibility="$(PACKAGE="$package" OWNER="$OWNER" GHCR_TOKEN="$GHCR_TOKEN" python3 - <<'PY'
import json
import os
import urllib.request

request = urllib.request.Request(
    f"https://api.github.com/users/{os.environ['OWNER']}/packages/container/{os.environ['PACKAGE']}",
    headers={
        "Accept": "application/vnd.github+json",
        "Authorization": f"Bearer {os.environ['GHCR_TOKEN']}",
        "X-GitHub-Api-Version": "2022-11-28",
    },
)
with urllib.request.urlopen(request, timeout=30) as response:
    print(json.load(response).get("visibility", ""))
PY
)"
  [[ "$visibility" == "private" ]] || die "GHCR package $package is not confirmed Private"
}

runtime_dir="$work/runtime-context/runtime-assets"
mkdir -p "$runtime_dir"
info "Exporting and validating the reviewed runtime…"
uv run --project "$ROOT_DIR" python "$ROOT_DIR/tools/export_runtime_assets.py" --output-dir "$runtime_dir" >/dev/null
uv run --project "$ROOT_DIR" python "$ROOT_DIR/tools/validate_runtime_assets.py" "$runtime_dir"
uv run --project "$ROOT_DIR" python "$ROOT_DIR/tools/verify_runtime_asset_parity.py" "$runtime_dir"

runtime_hash="$(sha256sum "$runtime_dir/checksums.sha256" | cut -c1-16)"
runtime_tag="runtime-$runtime_hash"
runtime_image="$RUNTIME_REPOSITORY:$runtime_tag"
release_time="$(date -u +%Y%m%dT%H%M%SZ)"
source_revision="$(git -C "$ROOT_DIR" rev-parse HEAD)"
app_tag="release-$release_time-sha-${source_revision:0:12}-runtime-$runtime_hash"
APP_TAG="${NEXUS_APP_TAG:-$app_tag}"
app_image="$APP_REPOSITORY:$APP_TAG"
cp "$ROOT_DIR/Dockerfile.runtime" "$work/runtime-context/Dockerfile"

info "Building immutable runtime image $runtime_image…"
runtime_metadata="$work/runtime-metadata.json"
docker buildx build --pull --platform linux/amd64 --provenance=false --push \
  --label "org.opencontainers.image.source=https://github.com/$OWNER/N.E.X.U.S-ML-V2" \
  --label "io.nexus.runtime.sha256=$runtime_hash" \
  --metadata-file "$runtime_metadata" \
  --tag "$runtime_image" "$work/runtime-context"
require_private_package nexus-ml-v2-runtime
runtime_digest="$(METADATA="$runtime_metadata" python3 - <<'PY'
import json
import os
from pathlib import Path

print(json.loads(Path(os.environ["METADATA"]).read_text())["containerimage.digest"])
PY
)"
runtime_digest_ref="$RUNTIME_REPOSITORY@$runtime_digest"
[[ "$runtime_digest_ref" =~ ^${RUNTIME_REPOSITORY}@sha256:[0-9a-f]{64}$ ]] || die "could not resolve the pushed runtime to an immutable digest"

info "Building application candidate $app_image…"
app_metadata="$work/app-metadata.json"
docker buildx build --pull --platform linux/amd64 --provenance=false --push \
  --build-arg "NEXUS_RUNTIME_IMAGE=$runtime_digest_ref" \
  --build-arg "VCS_REF=$source_revision" \
  --build-arg "RUNTIME_REF=$runtime_digest_ref" \
  --metadata-file "$app_metadata" \
  --tag "$app_image" "$ROOT_DIR"
require_private_package nexus-ml-v2
app_digest="$(METADATA="$app_metadata" python3 - <<'PY'
import json
import os
from pathlib import Path

print(json.loads(Path(os.environ["METADATA"]).read_text())["containerimage.digest"])
PY
)"
app_digest_ref="$APP_REPOSITORY@$app_digest"
[[ "$app_digest_ref" =~ ^${APP_REPOSITORY}@sha256:[0-9a-f]{64}$ ]] || die "could not resolve the pushed application to an immutable digest"
docker pull "$app_digest_ref" >/dev/null

key_file="$work/api.key"
python3 -c 'import secrets; print("nxs_" + secrets.token_urlsafe(32))' >"$key_file"
chmod 600 "$key_file"
container="nexus-publish-check-$$"
info "Starting the candidate for engine/authentication validation…"
docker run --detach --name "$container" \
  --user "$(id -u):$(id -g)" \
  --read-only --cap-drop ALL --security-opt no-new-privileges \
  --tmpfs /tmp:size=256m,mode=1777 \
  --mount "type=bind,src=$key_file,dst=/run/secrets/nexus_api_key,readonly" \
  --env NEXUS_API_KEY_FILE=/run/secrets/nexus_api_key \
  --env NEXUS_REQUIRE_API_KEY=true \
  --publish 127.0.0.1::8000 \
  "$app_digest_ref" >/dev/null
port="$(docker port "$container" 8000/tcp | sed -n 's/.*://p' | head -1)"
[[ -n "$port" ]] || die "failed to discover candidate port"
deadline=$((SECONDS + WAIT_SECONDS))
ready=false
while ((SECONDS < deadline)); do
  if curl --fail --silent --max-time 5 "http://127.0.0.1:$port/v2/health" | python3 -c 'import json,sys; d=json.load(sys.stdin); raise SystemExit(0 if d.get("status")=="ok" and d.get("engine_loaded") and d.get("authentication_required") else 1)' 2>/dev/null; then
    ready=true
    break
  fi
  sleep 3
done
if ! $ready; then
  docker logs --tail 160 "$container" >&2 || true
  die "candidate did not become ready"
fi
key="$(tr -d '\r\n' <"$key_file")"
unauth="$(curl --silent --output /dev/null --write-out '%{http_code}' "http://127.0.0.1:$port/v2/jobs/publish-check")"
auth="$(curl --silent --output /dev/null --write-out '%{http_code}' -H "Authorization: Bearer ${key}" "http://127.0.0.1:$port/v2/jobs/publish-check")"
[[ "$unauth" == "401" && "$auth" == "404" ]] || die "candidate authentication check failed"
docker rm -f "$container" >/dev/null
container=""
ok "Candidate engine and authentication checks passed."

# Immutable candidates were pushed before validation. Stable moves only after
# the exact application digest passes the live engine/authentication gate.
docker buildx imagetools create --tag "$RUNTIME_REPOSITORY:stable" "$runtime_digest_ref"
docker buildx imagetools create --tag "$APP_REPOSITORY:stable" "$app_digest_ref"

if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
  gh variable set NEXUS_RUNTIME_IMAGE --repo "$OWNER/N.E.X.U.S-ML-V2" --body "$runtime_digest_ref" || true
fi

ok "Published private runtime: $runtime_digest_ref"
ok "Published private application: $app_digest_ref"
ok "Promoted: $RUNTIME_REPOSITORY:stable and $APP_REPOSITORY:stable"
printf '\nKeep both GHCR packages Private and grant this repository Actions access to the runtime package.\n'
