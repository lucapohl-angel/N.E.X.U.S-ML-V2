# Created automatically by ./scripts/nexus-server install.
# Keep the real .env private and mode 0600.
NEXUS_API_KEY_FILE=/opt/nexus-v2/.env.key
NEXUS_RUNTIME_ASSETS_DIR=/opt/nexus-v2/runtime-assets
NEXUS_BIND_ADDRESS=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_PERFORMANCE_PROFILE=auto
NEXUS_MAX_RETAINED_JOBS=64
NEXUS_MAX_UPLOAD_BYTES=52428800
NEXUS_MEMORY_LIMIT=4g
NEXUS_IMAGE_TAG=local
