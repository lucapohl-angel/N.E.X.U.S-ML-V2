#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${NEXUS_ENV_FILE:-$ROOT_DIR/.env}"
COMPOSE_FILE="$ROOT_DIR/compose.yaml"
RUNTIME_ARCHIVE=""
WAIT_SECONDS="${NEXUS_STARTUP_TIMEOUT:-240}"

info() { printf '\033[1;36m[nexus]\033[0m %s\n' "$*"; }
ok() { printf '\033[1;32m[nexus]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[nexus]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[nexus]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Nexus V2 server manager

Usage:
  ./scripts/nexus-server install [--runtime-assets FILE] [--public] [--port PORT]
  ./scripts/nexus-server update
  ./scripts/nexus-server status
  ./scripts/nexus-server logs [docker compose logs options]
  ./scripts/nexus-server restart | stop | start
  ./scripts/nexus-server key | rotate-key
  ./scripts/nexus-server uninstall [--purge-assets]

Install/update are idempotent. The default bind address is 127.0.0.1; put a TLS
reverse proxy in front of it. Use --public only when the server firewall and TLS
termination are already configured.
EOF
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

docker_ready() {
  docker info >/dev/null 2>&1
}

require_docker() {
  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required (docker compose)."
  docker_ready || die "Docker is installed but unavailable. Start the daemon and ensure this user can access it."
}

ensure_env() {
  local bind_address="${1:-127.0.0.1}"
  local port="${2:-8000}"
  if [[ -f "$ENV_FILE" ]]; then
    chmod 600 "$ENV_FILE"
    local existing_key_file
    existing_key_file="$(env_value NEXUS_API_KEY_FILE)"
    [[ -s "$existing_key_file" ]] || die "API key file is missing or empty: $existing_key_file"
    chmod 600 "$existing_key_file"
    return
  fi
  require_command python3
  local key key_file
  key="$(python3 -c 'import secrets; print("nxs_" + secrets.token_urlsafe(32))')"
  key_file="${ENV_FILE}.key"
  umask 077
  printf '%s\n' "$key" >"$key_file"
  cat >"$ENV_FILE" <<EOF
NEXUS_API_KEY_FILE=$key_file
NEXUS_RUNTIME_ASSETS_DIR=$ROOT_DIR/runtime-assets
NEXUS_BIND_ADDRESS=$bind_address
NEXUS_API_PORT=$port
NEXUS_PERFORMANCE_PROFILE=auto
NEXUS_MAX_RETAINED_JOBS=64
NEXUS_MAX_UPLOAD_BYTES=52428800
NEXUS_MEMORY_LIMIT=4g
NEXUS_IMAGE_TAG=local
EOF
  chmod 600 "$ENV_FILE" "$key_file"
  ok "Generated a 256-bit API key in $key_file (mode 0600)."
}

env_value() {
  local key="$1"
  [[ -f "$ENV_FILE" ]] || die "missing $ENV_FILE; run install first"
  local value
  value="$(grep -m1 -E "^${key}=" "$ENV_FILE" | cut -d= -f2- || true)"
  [[ -n "$value" ]] || die "$key is missing from $ENV_FILE"
  printf '%s' "$value"
}

api_key() {
  local key_file
  key_file="$(env_value NEXUS_API_KEY_FILE)"
  [[ -s "$key_file" ]] || die "API key file is missing or empty: $key_file"
  local key
  key="$(tr -d '\r\n' <"$key_file")"
  ((${#key} >= 16)) || die "API key file contains an invalid short key"
  printf '%s' "$key"
}

set_env_value() {
  local key="$1" value="$2"
  require_command python3
  KEY="$key" VALUE="$value" ENV_FILE="$ENV_FILE" python3 - <<'PY'
import os
from pathlib import Path
path = Path(os.environ["ENV_FILE"])
key = os.environ["KEY"]
value = os.environ["VALUE"]
lines = path.read_text(encoding="utf-8").splitlines()
replaced = False
for index, line in enumerate(lines):
    if line.startswith(key + "="):
        lines[index] = f"{key}={value}"
        replaced = True
        break
if not replaced:
    lines.append(f"{key}={value}")
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
  chmod 600 "$ENV_FILE"
}

compose() {
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
}

install_runtime_assets() {
  local runtime_dir
  runtime_dir="$(env_value NEXUS_RUNTIME_ASSETS_DIR)"
  if [[ -n "$RUNTIME_ARCHIVE" ]]; then
    require_command python3
    local archive
    archive="$(python3 -c 'import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))' "$RUNTIME_ARCHIVE")"
    [[ -f "$archive" ]] || die "runtime asset archive not found: $archive"
    local parent temporary backup
    parent="$(dirname -- "$runtime_dir")"
    temporary="${runtime_dir}.new.$$"
    backup="${runtime_dir}.previous.$$"
    mkdir -p "$parent"
    rm -rf "$temporary"
    mkdir -p "$temporary"
    ARCHIVE="$archive" DESTINATION="$temporary" python3 - <<'PY'
import os
import tarfile
from pathlib import Path

archive = Path(os.environ["ARCHIVE"])
destination = Path(os.environ["DESTINATION"]).resolve()
with tarfile.open(archive, "r:gz") as bundle:
    for member in bundle.getmembers():
        target = (destination / member.name).resolve()
        if not target.is_relative_to(destination):
            raise SystemExit(f"unsafe runtime archive path: {member.name}")
        if member.issym() or member.islnk() or not (member.isfile() or member.isdir()):
            raise SystemExit(f"unsupported runtime archive entry: {member.name}")
    bundle.extractall(destination)
PY
    python3 "$ROOT_DIR/tools/validate_runtime_assets.py" "$temporary"
    if [[ -d "$runtime_dir" ]]; then
      mv "$runtime_dir" "$backup"
    fi
    mv "$temporary" "$runtime_dir"
    rm -rf "$backup"
    chmod -R a=rX,u+w "$runtime_dir"
    ok "Installed the private runtime bundle at $runtime_dir."
  fi
  [[ -d "$runtime_dir" ]] || die "runtime assets are missing at $runtime_dir. Pass --runtime-assets nexus-runtime-assets.tar.gz."
  python3 "$ROOT_DIR/tools/validate_runtime_assets.py" "$runtime_dir"
}

wait_ready() {
  local port bind host deadline health
  port="$(env_value NEXUS_API_PORT)"
  bind="$(env_value NEXUS_BIND_ADDRESS)"
  host="$bind"
  [[ "$host" == "0.0.0.0" || "$host" == "::" ]] && host="127.0.0.1"
  [[ "$host" == *:* ]] && host="[$host]"
  health="http://${host}:${port}/v2/health"
  deadline=$((SECONDS + WAIT_SECONDS))
  while (( SECONDS < deadline )); do
    if curl --fail --silent --max-time 5 "$health" | python3 -c 'import json,sys; d=json.load(sys.stdin); raise SystemExit(0 if d.get("status")=="ok" and d.get("engine_loaded") and d.get("authentication_required") else 1)' 2>/dev/null; then
      verify_auth "$host" "$port"
      ok "API is healthy and authenticated at http://${host}:${port}."
      return
    fi
    sleep 3
  done
  compose ps >&2 || true
  compose logs --tail 120 nexus-api >&2 || true
  die "API did not become ready within ${WAIT_SECONDS}s"
}

verify_auth() {
  local host="$1" port="$2" key unauth auth
  key="$(api_key)"
  unauth="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 "http://${host}:${port}/v2/jobs/security-check")"
  [[ "$unauth" == "401" ]] || die "security check failed: unauthenticated protected request returned HTTP $unauth"
  auth="$(curl --silent --output /dev/null --write-out '%{http_code}' --max-time 10 -H "Authorization: Bearer $key" "http://${host}:${port}/v2/jobs/security-check")"
  [[ "$auth" == "404" ]] || die "security check failed: authenticated protected request returned HTTP $auth"
}

install_or_update() {
  local action="$1" bind="127.0.0.1" port="8000"
  shift
  while (($#)); do
    case "$1" in
      --runtime-assets) (($# >= 2)) || die "--runtime-assets requires a file"; RUNTIME_ARCHIVE="$2"; shift 2 ;;
      --public) bind="0.0.0.0"; shift ;;
      --port) (($# >= 2)) || die "--port requires a number"; port="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || die "port must be between 1 and 65535"
  require_docker
  require_command curl
  require_command python3
  require_command tar
  ensure_env "$bind" "$port"
  if [[ "$action" == "install" ]]; then
    set_env_value NEXUS_BIND_ADDRESS "$bind"
    set_env_value NEXUS_API_PORT "$port"
  fi
  install_runtime_assets
  compose config --quiet
  info "Building the production API image…"
  compose build --pull nexus-api
  info "Starting/updating the service…"
  compose up --detach --remove-orphans nexus-api
  wait_ready
  printf '\nAPI key (store it in your backend secret manager):\n%s\n\n' "$(api_key)"
  printf 'Health: curl http://127.0.0.1:%s/v2/health\n' "$(env_value NEXUS_API_PORT)"
  printf 'Logs:   ./scripts/nexus-server logs -f\n'
}

case "${1:-}" in
  install) shift; install_or_update install "$@" ;;
  update) shift; install_or_update update "$@" ;;
  start) shift; require_docker; compose up --detach nexus-api; wait_ready ;;
  stop) shift; require_docker; compose stop nexus-api ;;
  restart) shift; require_docker; compose restart nexus-api; wait_ready ;;
  status) shift; require_docker; compose ps; [[ "$(compose ps --status running --services)" == *"nexus-api"* ]] && wait_ready ;;
  logs) shift; require_docker; compose logs "$@" nexus-api ;;
  key) shift; api_key; printf '\n' ;;
  rotate-key)
    shift; require_command python3; require_docker
    [[ -f "$ENV_FILE" ]] || die "run install first"
    key_file="$(env_value NEXUS_API_KEY_FILE)"
    umask 077
    python3 -c 'import secrets; print("nxs_" + secrets.token_urlsafe(32))' >"${key_file}.new"
    chmod 600 "${key_file}.new"
    mv "${key_file}.new" "$key_file"
    compose up --detach --force-recreate nexus-api
    wait_ready
    printf 'New API key:\n%s\n' "$(api_key)"
    ;;
  uninstall)
    shift; require_docker
    purge=false
    [[ "${1:-}" == "--purge-assets" ]] && purge=true && shift
    (($# == 0)) || die "unknown uninstall option: $1"
    if [[ -f "$ENV_FILE" ]]; then
      key_file="$(env_value NEXUS_API_KEY_FILE)"
      compose down --remove-orphans || true
      if $purge; then rm -rf -- "$(env_value NEXUS_RUNTIME_ASSETS_DIR)"; fi
      rm -f -- "$key_file" "$ENV_FILE"
    else
      warn "No local installation file found."
    fi
    if $purge; then
      ok "Nexus V2 service and runtime assets removed."
    else
      ok "Nexus V2 service removed; runtime assets were preserved."
    fi
    ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
