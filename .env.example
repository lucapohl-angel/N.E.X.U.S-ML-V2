# Environment Configuration Template
# Copy this file to .env and fill in your values

# ====================
# DATABASE
# ====================

# For production (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/squad_stats

# For development (SQLite)
# DATABASE_URL=sqlite:///./squad_stats.db

# ====================
# APPLICATION
# ====================

# Environment: development, production, testing
ENVIRONMENT=development

# Secret key for JWT/sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-this-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Auto-reload on code changes (development only)

# ====================
# OCR SETTINGS
# ====================

# Path to Tesseract OCR executable (if not in PATH)
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/Mac: usually /usr/bin/tesseract or /usr/local/bin/tesseract
TESSERACT_CMD=tesseract

# OCR Language (usually 'eng' for English)
TESSERACT_LANG=eng

# ====================
# FILE STORAGE
# ====================

# Local storage path for uploaded screenshots
UPLOAD_DIR=./uploads

# Maximum upload file size (bytes) - 10MB default
MAX_UPLOAD_SIZE=10485760

# ====================
# PROCESSING
# ====================

# Number of worker processes for background tasks
WORKER_PROCESSES=2

# Task timeout (seconds)
TASK_TIMEOUT=60

# ====================
# REDIS (if using Celery)
# ====================

# REDIS_URL=redis://localhost:6379/0

# ====================
# LOGGING
# ====================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE=./logs/squad_stats.log

# ====================
# CORS (for web clients)
# ====================

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ====================
# DISCORD BOT (optional)
# ====================

# API key for Discord bot authentication
# DISCORD_BOT_API_KEY=your-discord-bot-api-key

# ====================
# MONITORING (optional)
# ====================

# Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn-here

# Enable performance monitoring
# ENABLE_METRICS=true
